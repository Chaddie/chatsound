    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tone": "^15.1.22",
    "ws": "^8.21.3",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
