# Server-only — never prefix with VITE_
XAI_API_KEY=your_xai_api_key_here
# Optional chat model for lyric writing (default grok-3)
XAI_MODEL=grok-3
PORT=8787

# Client — Cloudflare Workers host for live share (no https://)
# Local: 127.0.0.1:1999 (default in DEV if unset)
# Prod: chatsound-collab.<your-subdomain>.workers.dev after `npm run deploy:party`
VITE_PARTYKIT_HOST=127.0.0.1:1999
